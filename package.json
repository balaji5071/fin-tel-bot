{
  "name": "finance-bot",
  "version": "1.0.0",
  "description": "Production-ready Telegram Finance Tracking Bot built with Node.js, Telegraf, Prisma, and MySQL",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:push": "prisma db push",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "telegram-bot",
    "telegraf",
    "prisma",
    "mysql",
    "finance",
    "expense-tracker"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7",
    "groq-sdk": "^1.6.0",
    "telegraf": "^4.16.3",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  }
}
