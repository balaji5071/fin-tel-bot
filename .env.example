# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ

# MySQL Connection String for Prisma
DATABASE_URL="mysql://root:password@localhost:3306/finance_bot"

# Authorized Telegram Super Admin IDs (comma-separated)
SUPER_ADMIN_IDS="8530973341"

# Authorized Telegram Admin IDs (comma-separated)
ADMIN_IDS="123456789,987654321"

# Application Environment (development / production)
NODE_ENV=development

# Logging Level (debug / info / warn / error)
LOG_LEVEL=info

# Groq API Configuration for Conversational AI Financial Employee
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Vercel Serverless & Webhook Settings (Optional) ---
# Your deployed production domain (e.g., https://fin-tel-bot.vercel.app)
APP_URL=https://your-project.vercel.app

# Optional secret token to verify Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=your_optional_random_webhook_secret_here

# Optional secret token to secure Vercel Cron triggers
CRON_SECRET=your_optional_cron_secret_here

