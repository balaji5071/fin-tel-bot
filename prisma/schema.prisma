// Complete Production Schema for Phase 2 - Phase 12 Enterprise Finance Bot

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id                Int                @id @default(autoincrement())
  telegramId        BigInt             @unique
  username          String?
  firstName         String?
  role              Role               @default(EMPLOYEE)
  department        String?            @default("General")
  customPermissions String?            @db.Text // JSON string array of extra permissions
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  expenses          Expense[]
  receipts          ExpenseReceipt[]
  auditLogs         AuditLog[]         @relation("ActorLogs")
  notifications     Notification[]
  recurringExpenses RecurringExpense[]
  incomes           Income[]
  messages          ConversationMessage[]

  @@map("users")
}

model Expense {
  id          Int              @id @default(autoincrement())
  amount      Float
  category    String
  note        String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  userId      Int
  vendorId    Int?
  department  String?          @default("General")
  isDeleted   Boolean          @default(false)
  deletedAt   DateTime?
  deletedBy   Int?

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor      Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  receipts    ExpenseReceipt[]

  @@index([userId])
  @@index([createdAt])
  @@index([category])
  @@index([department])
  @@index([vendorId])
  @@map("expenses")
}

model ExpenseReceipt {
  id              Int       @id @default(autoincrement())
  expenseId       Int?
  fileId          String
  uploadedBy      Int
  uploadedAt      DateTime  @default(now())
  extractedAmount Float?
  extractedVendor String?
  extractedDate   DateTime?
  extractedGst    String?
  confirmed       Boolean   @default(false)

  expense         Expense?  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([uploadedBy])
  @@map("expense_receipts")
}

model Budget {
  id           Int      @id @default(autoincrement())
  month        Int
  year         Int
  amount       Float
  alert50Sent  Boolean  @default(false)
  alert75Sent  Boolean  @default(false)
  alert90Sent  Boolean  @default(false)
  alert100Sent Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([month, year])
  @@map("budgets")
}

model DepartmentBudget {
  id         Int      @id @default(autoincrement())
  department String
  month      Int
  year       Int
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([department, month, year])
  @@map("department_budgets")
}

model Vendor {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  expenses  Expense[]
  recurring RecurringExpense[]

  @@map("vendors")
}

model RecurringExpense {
  id         Int       @id @default(autoincrement())
  amount     Float
  category   String
  note       String?
  frequency  Frequency
  nextRun    DateTime
  active     Boolean   @default(true)
  userId     Int
  department String?   @default("General")
  vendorId   Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor     Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([nextRun])
  @@map("recurring_expenses")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int
  action    String
  target    String
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  actor     User     @relation("ActorLogs", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

model CashBalance {
  id        Int      @id @default(autoincrement())
  amount    Float
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy Int?

  @@map("cash_balance")
}

model Income {
  id          Int      @id @default(autoincrement())
  amount      Float
  source      String
  description String?  @db.Text
  receivedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  department  String?  @default("General")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([receivedAt])
  @@index([source])
  @@map("incomes")
}

model ConversationMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  role      String
  content   String   @db.Text
  intent    String?
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("conversation_messages")
}

model Setting {
  id             Int      @id @default(autoincrement())
  openingBalance Float    @default(0) @map("opening_balance")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("settings")
}


